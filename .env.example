# 복사해서 .env 로 저장하고 값 채우기:  cp .env.example .env

# ---- LLM 엔진 키 (사용하는 엔진 것만 있으면 됨) ----
ANTHROPIC_API_KEY=sk-ant-...   # main.py 기본 엔진(claude): 생성 opus-4-8 / 평가 sonnet-4-6
OPENAI_API_KEY=sk-...          # --engine openai / daily.py(아케이드 빌드): gpt-5.4-mini

# ---- (선택) Slack 알림 ----
# Incoming Webhook URL. 있으면 기획/개발/평가/QA/배포 에이전트가 진행상황을 '회사 팀'처럼 중계
SLACK_WEBHOOK_URL=

# ---- (선택) LangSmith 추적 ----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-game-pipeline

# ---- (선택) 자동배포 (main.py 단건 경로, Netlify) ----
# daily.py 아케이드는 site/ 를 git push 해 GitHub Pages 로 배포한다(아래 README 참고).
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# ---- (선택) Chrome 실행 파일 경로 자동탐지 실패 시 지정 ----
CHROME_PATH=
